# Tuan Tanah web tier — INTERNAL static host + API proxy.
#
# This Caddy no longer faces the internet. The platform edge
# (Katzelabs/platform, compose/edge.yml) owns :80/:443 for the whole box,
# terminates TLS, and reverse-proxies here over the `platform` Docker network.
#
# Consequences, and why this file is much smaller than it used to be:
#
#   - No `email` / ACME block. This server never obtains a certificate. Leaving
#     `email {$ACME_EMAIL}` here after the variable was removed from compose is
#     exactly what broke the first cutover attempt: it expands to nothing and
#     Caddy refuses to start with "wrong argument count", so the container
#     crash-looped, had no IP, and the edge's {{upstreams 80}} rendered as a
#     bare `:80` — which made the edge proxy to ITSELF and 308-loop.
#
#   - No security headers or CSP. Those now live in the edge's base Caddyfile as
#     the (security_headers) and (csp_spa) snippets, imported via docker labels,
#     so every app on the box gets them and none can forget them.
#
#   - Binds {$DOMAIN}, which compose sets to `:80` — plain HTTP, no hostname
#     matching, no TLS. The public hostname is the edge's concern.
#
# For local `docker compose up` without the edge, set DOMAIN=:80 and reach it
# directly on the container port.

{$DOMAIN} {
	# Cap request bodies — this API has no large-upload routes. Kept here rather
	# than on the edge because it is a property of THIS app's routes.
	request_body {
		max_size 64KB
	}

	# REST API (room creation, health).
	handle /api/* {
		reverse_proxy backend:3000
	}

	# Socket.io — Caddy upgrades to WebSocket automatically, at both hops.
	handle /socket.io/* {
		reverse_proxy backend:3000
	}

	# Built React SPA — fall back to index.html for client-side routes.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
