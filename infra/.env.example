# Platform stack config. Copy to infra/.env on the VPS — never commit the real file.

# Postgres image, shared by the server and the pg_dumpall backup client (they must
# match, or dumps fail on a version mismatch). Every tenant on this instance shares
# this major version, so it tracks the most demanding one — currently konku (pg17 +
# pgvector). Bumping the major version is a coordinated migration for ALL tenants.
POSTGRES_IMAGE=pgvector/pgvector:pg17

# Loopback host port for psql/pg_dump from the shell. App stacks do NOT use this —
# they reach Postgres as `postgres:5432` over the `platform` network. Change it if
# something else on the box already publishes 5432.
POSTGRES_HOST_PORT=5432

# Postgres superuser. Only the platform stack and the provisioning/backup scripts
# use this; app stacks get their own least-privilege role per database.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=

# Backup loop (pg_dumpall -> infra/backups).
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
