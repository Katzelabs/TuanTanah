NODE_ENV=development
PORT=3000

# Postgres (optional — archives final game history on game-over; leave blank to disable).
# Apply the schema with: pnpm --filter server migrate   (prod: `make migrate`)
#
# Local dev (docker-compose.dev.yml):
#   postgres://tuan:tuan@localhost:5432/tuan_tanah
# Production: the SHARED platform Postgres (Katzelabs/platform — see infra/README.md).
# Host is the `postgres` service name on the `platform` Docker network, never
# localhost and never a published port. Provision the tenant from that repo:
#   cd ~/projects/platform && make provision NAME=tuantanah_prod PASS='...'
#   postgres://tuantanah_prod:<password>@postgres:5432/tuantanah_prod
DATABASE_URL=

# Redis — leave blank to use in-memory store (local dev without Docker).
# The prod compose stack always overrides this to redis://redis:6379; Redis is
# never shared between projects because it holds live game state.
REDIS_URL=redis://localhost:6379

# Allowed browser origins (comma-separated). Defaults to the dev client.
# REQUIRED in production: set to your real origin(s); the server refuses to
# start in production if this is empty, a wildcard, or localhost.
# Prod: CORS_ORIGINS=https://tuantanah.fun
CORS_ORIGINS=http://localhost:5173

# Game config
ROOM_TTL_HOURS=24

# Client (Vite) — URL the browser uses to reach the socket server.
# Leave blank in dev (Vite proxy) and in prod (same-origin via Caddy).
VITE_SERVER_URL=

# Public site origin used for social-share link previews (og:/twitter: tags),
# baked into index.html at build time and passed to the client image as a build
# arg. Leave blank for root-relative URLs (fine in dev / most crawlers).
# Prod: VITE_PUBLIC_URL=https://tuantanah.fun
VITE_PUBLIC_URL=

# BUILD_SHA is deliberately NOT here. It identifies the commit an image was built
# from, so a value pinned in a file would be wrong the moment anything else is
# deployed. The Makefile resolves it (`git rev-parse --short HEAD`) and passes it
# to both images as a build arg; unset, both tiers report `dev`.

# --- Production only (used by docker-compose.yml) ---
# Public hostname this app answers to. Compose puts it in the `caddy` label; the
# platform edge (Katzelabs/platform, compose/edge.yml) routes it and terminates
# TLS. This stack never obtains a certificate itself, so there is no ACME_EMAIL.
DOMAIN=tuantanah.fun

# --- Player accounts (ClickUp epic 86ey2z15b) ---
# Google OAuth. BLANK DISABLES ACCOUNTS ENTIRELY and the game stays fully
# guest-playable — same opt-in idiom as SENTRY_DSN / DATABASE_URL.
#
# DATABASE_URL above is part of "configured": accounts are rows in Postgres, so
# credentials without a database also mean accounts off (the server logs which of
# the two it is at startup). Apply the schema with `pnpm --filter server migrate`.
#
# Get these from Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID → Web application. Scopes MUST be openid/email/profile only:
# they are non-sensitive, so there is no verification review and no cost.
# Authorized redirect URIs (byte-exact):
#   http://localhost:5173/api/auth/google/callback     (dev, via the Vite proxy)
#   https://tuantanah.fun/api/auth/google/callback     (prod)
# Real values go in .env, which is gitignored — this file is committed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin this app is reached at — used to build the OAuth redirect URI.
# Dev: http://localhost:5173   Prod: https://tuantanah.fun
PUBLIC_ORIGIN=http://localhost:5173

# Idle lifetime of a signed-in session, in days. Sliding — every use pushes it
# forward, so this is how long an account may sit unused before it must sign in
# again, not a hard cap. Sessions live in Redis (`sess:<id>`); with REDIS_URL
# blank they fall back to memory and end with the process.
SESSION_TTL_DAYS=30

# Sentry error tracking (optional — blank disables it, and nothing else changes).
# Only genuine faults are sent: rejected player actions are EngineErrors and are
# filtered out at the source, in realtime/common.ts. Real DSN goes in .env, which
# is gitignored — this file is committed.
# Prod: SENTRY_DSN=https://<key>@o<org>.ingest.de.sentry.io/<project>
SENTRY_DSN=
